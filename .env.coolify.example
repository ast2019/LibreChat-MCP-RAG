# Variables for docker-compose.yml.
# On Coolify you only enter OPENROUTER_KEY (and optional values); every SERVICE_* value is
# generated by Coolify. For a plain `docker compose` run outside Coolify, copy this file to
# `.env` and fill every value yourself.

# Required
OPENROUTER_KEY=

# Generated by Coolify. For a manual run, create them with the commands shown.
SERVICE_URL_API=http://localhost
SERVICE_HEX_64_CREDSKEY=      # openssl rand -hex 32
SERVICE_HEX_32_CREDSIV=       # openssl rand -hex 16
SERVICE_HEX_64_JWTSECRET=     # openssl rand -hex 32
SERVICE_HEX_64_JWTREFRESH=    # openssl rand -hex 32
SERVICE_HEX_64_SEARXNG=       # openssl rand -hex 32
SERVICE_HEX_64_OPENIDSESSION= # openssl rand -hex 32
SERVICE_HEX_64_BROWSER=       # openssl rand -hex 32
SERVICE_USER_MONGO=librechat
SERVICE_PASSWORD_MONGO=       # openssl rand -hex 16
SERVICE_PASSWORD_64_MEILI=    # openssl rand -hex 32
SERVICE_USER_POSTGRES=rag
SERVICE_PASSWORD_POSTGRES=    # openssl rand -hex 16

# Optional
APP_TITLE=HiveGPT
# Empty uses the default disclaimer under the composer; write your own to replace it.
CUSTOM_FOOTER=
HELP_AND_FAQ_URL=/
NO_INDEX=true
ALLOW_REGISTRATION=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
ALLOW_PASSWORD_RESET=false
KEENABLE_API_KEY=
EMBEDDINGS_MODEL=openai/text-embedding-3-large
EMBEDDINGS_DIMENSIONS=1536
# Web search reranking (optional): https://jina.ai/reranker or https://cohere.com
JINA_API_KEY=
COHERE_API_KEY=
# Web search, tried in this order; when one runs out of credit the next answers, then the free
# SearXNG. Empty = skipped. https://serper.dev · https://serpapi.com · https://tavily.com
SERPER_API_KEY=
SERPAPI_API_KEY=
TAVILY_API_KEY=
# Mobile sign-in (Kavenegar). Create a Verify Lookup template with one %token% in the panel.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
# Pack purchase. ZarinPal merchant code (36 characters) and/or IDPay API key.
ZARINPAL_MERCHANT_ID=
IDPAY_API_KEY=
# Lower if the build server has less than ~8 GB of RAM (the client build needs it).
NODE_MAX_OLD_SPACE_SIZE=6144
# Agent browser container: CPU and memory caps (about 300-500 MB per open browser).
BROWSER_CPUS=4
BROWSER_MEMORY=6g

# OpenID Connect login (optional; the button shows once issuer/client id/secret are set)
OPENID_ISSUER=
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_SCOPE=openid profile email
OPENID_BUTTON_LABEL=
OPENID_IMAGE_URL=
OPENID_USE_PKCE=false
OPENID_USERNAME_CLAIM=
OPENID_NAME_CLAIM=
ALLOW_SOCIAL_REGISTRATION=true

# Local model (ollama service). The container builds `hivegpt-local` from LOCAL_MODEL, so the
# yaml keeps one model name. Keep LOCAL_MODEL_THREADS <= LOCAL_MODEL_CPUS (ideally the number
# of physical cores the VM gets); more threads than CPUs makes it many times slower.
LOCAL_MODEL=gemma3:4b
LOCAL_MODEL_THREADS=12
LOCAL_MODEL_CPUS=12
LOCAL_MODEL_CONTEXT=8192
LOCAL_MODEL_KEEP_ALIVE=30m
LOCAL_MODEL_PARALLEL=1
# Admin-only uncensored model (~23 GB download, ~22 GB RAM while loaded); `none` skips it
LOCAL_MODEL_UNCENSORED=huihui_ai/Qwen3.6-abliterated:35b
LOCAL_MODEL_UNCENSORED_CONTEXT=16384
LOCAL_MODEL_MEMORY=32g

# Passkeys (fingerprint / face / device PIN sign-in for every user). They need HTTPS:
# enter the Coolify domain of the `api` service as https://chat.example.com (Coolify issues
# the Let's Encrypt certificate automatically), so DOMAIN_CLIENT/DOMAIN_SERVER become that
# https:// URL. Over http:// the button, Settings panel and nudge stay hidden.
# Verify: <domain>/api/config shows "passkeyLoginEnabled": true.
ALLOW_PASSKEY_LOGIN=true
PASSKEY_RP_NAME=HiveGPT
# Bare hostname, e.g. chat.example.com (no https://, port or path). Empty = taken from
# DOMAIN_CLIENT. Pin it to the current hostname before moving domains, or existing passkeys
# stop working.
PASSKEY_RP_ID=
# Empty = Secure cookies on https://, plain on http://. true/false forces one.
SESSION_COOKIE_SECURE=

# SMTP (optional; needed for email verification and password reset)
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=
